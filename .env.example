# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key（僅用於服務端 API）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 釘釘群機器人 webhook（含 access_token）
# 在釘釘群 → 群設定 → 智能群助手 → 添加機器人 → 自定義 取得
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# 釘釘加簽密鑰（如果機器人開了「加簽」安全設定才需要；SEC 開頭）
DINGTALK_SECRET=

# 內部 API secret（用於 /api/dingtalk/push 等內部端點）
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# 網站域名（用於生成搶單鏈接）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 司機端網站域名（H5 搶單頁指向的網址；可與 SITE_URL 相同）
NEXT_PUBLIC_DRIVER_SITE_URL=http://localhost:3000

# 企業微信 Webhook（舊版相容，可留空）
WECHAT_WEBHOOK_URL=